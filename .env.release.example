# Trusted local Bash configuration. Keep credentials in Keychain, not this file.
# Release mode: developer-id (public distribution) or local (ad-hoc preview).
RELEASE_MODE=developer-id
APPLE_TEAM_ID=''
# Certificate common name or SHA-1; default lets Xcode select Developer ID Application.
APPLE_SIGNING_CERTIFICATE='Developer ID Application'
# true uploads the signed ZIP to Apple, waits for notarization, and staples the ticket.
RELEASE_NOTARIZE=true
APPLE_NOTARY_PROFILE=''
# Optional version overrides; empty values use project settings.
FANCAM_DUCK_VERSION=''
FANCAM_DUCK_BUILD_NUMBER=''
# Paths relative to repository root, or absolute paths.
FANCAM_DUCK_RELEASE_ROOT='build/macos'
FANCAM_DUCK_MAC_DERIVED_DATA='build/macos/DerivedData'
